{
  "name": "codesentry",
  "version": "0.1.0",
  "description": "CLI-based codebase inspection and DevSecOps tool with AI-powered analysis",
  "main": "CodeSentry/src/core/scan.js",
  "bin": {
    "codesentry": "./CodeSentry/bin/codesentry.js"
  },
  "preferGlobal": true,
  "files": [
    "CodeSentry/bin/",
    "CodeSentry/src/",
    "CodeSentry/package.json",
    "CodeSentry/README.md",
    "CodeSentry/.env.example"
  ],
  "scripts": {
    "start": "node CodeSentry/bin/codesentry.js",
    "scan": "node CodeSentry/bin/codesentry.js scan",
    "test": "npm test --prefix CodeSentry"
  },
  "keywords": [
    "codesentry",
    "code-analysis",
    "security",
    "devsecops",
    "static-analysis",
    "ai",
    "openrouter",
    "linter",
    "cli",
    "npx"
  ],
  "author": "CodeSentry Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaunteyaarjun/code_inspection_tool.git"
  },
  "bugs": {
    "url": "https://github.com/kaunteyaarjun/code_inspection_tool/issues"
  },
  "homepage": "https://github.com/kaunteyaarjun/code_inspection_tool#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
