# CodeSentry Environment Variables

# Anthropic API Key (optional)
# Enables AI-powered analysis for ambiguous findings,
# false-positive reduction, and contextual explanations.
# If not set, CodeSentry runs in deterministic-only mode.
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Override the default AI model
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: AI analysis timeout in milliseconds
# ANTHROPIC_TIMEOUT=30000
